<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/coffee_pulse">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#18FFA726"
                android:startColor="#33FFA726" />
            <stroke
                android:width="1.5dp"
                android:color="@color/coffee_amber" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</ripple>
